# ============================================================
# ArchiveDeew — Environment Variables Template
# Copy this file to .env and fill in your values.
# ============================================================

# ------ SUPABASE (required) ---------------------------------
# From: Supabase Dashboard → Settings → API

# Your project URL (safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your project's anon/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------ SUPABASE STORAGE (same project) --------------------
# These are only needed if you run the api-server locally.
# On Vercel (static frontend only), these are NOT required.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------ LEGACY REPLIT VARIABLES (can be deleted) -----------
# DATABASE_URL       — replaced by Supabase PostgreSQL
# SESSION_SECRET     — no longer needed (Supabase handles sessions)
# REPLIT_DOMAINS     — no longer needed
# REPL_ID            — only used by Replit dev plugins (auto-detected)
